<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Contrôle billet {{ ticket.ticketNumber }}</title>
<style>
    * { box-sizing: border-box; }

    body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        background: #f4f1ec;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: #1f1b16;
    }

    .card {
        width: 100%;
        max-width: 400px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .banner {
        padding: 20px;
        text-align: center;
        color: #fff;
    }
    .banner.ok { background: #1a8754; }
    .banner.warn { background: #c9820c; }
    .banner.danger { background: #c0392b; }
    .banner.pending { background: #cd935b; }

    .banner .icon { font-size: 36px; line-height: 1; margin-bottom: 6px; }
    .banner .title { font-size: 17px; font-weight: 700; }

    .body { padding: 20px; }

    .ticket-number {
        text-align: center;
        font-weight: 700;
        letter-spacing: 1px;
        font-size: 15px;
        padding: 8px;
        border: 1px solid #e3ddd3;
        border-radius: 8px;
        margin-bottom: 16px;
    }

    .row { display: flex; justify-content: space-between; gap: 12px; font-size: 14px; padding: 8px 0; border-bottom: 1px solid #efebe4; }
    .row:last-child { border-bottom: none; }
    .row .l { color: #7a7266; font-weight: 600; }
    .row .v { text-align: right; font-weight: 600; }

    .confirm-btn {
        display: block;
        width: 100%;
        margin-top: 20px;
        padding: 14px;
        font-size: 16px;
        font-weight: 700;
        text-align: center;
        background: #1a8754;
        color: #fff;
        border: none;
        border-radius: 10px;
        cursor: pointer;
    }
    .confirm-btn:active { opacity: 0.85; }

    .note { margin-top: 14px; font-size: 13px; text-align: center; color: #7a7266; }
</style>
</head>
<body>

<div class="card">
    {% if justChecked %}
        <div class="banner ok">
            <div class="icon">&#10003;</div>
            <div class="title">Entrée validée</div>
        </div>
    {% elseif ticket.status.value == 'used' %}
        <div class="banner warn">
            <div class="icon">&#9888;</div>
            <div class="title">Billet déjà utilisé</div>
        </div>
    {% elseif ticket.status.value == 'cancelled' %}
        <div class="banner danger">
            <div class="icon">&#10005;</div>
            <div class="title">Billet annulé</div>
        </div>
    {% else %}
        <div class="banner pending">
            <div class="icon">&#127909;</div>
            <div class="title">Contrôle d'accès</div>
        </div>
    {% endif %}

    <div class="body">
        <div class="ticket-number">N&deg; {{ ticket.ticketNumber }}</div>

        <div class="row"><span class="l">Participant</span><span class="v">{{ registration ? registration.fullName : '—' }}</span></div>
        <div class="row"><span class="l">Film</span><span class="v">{{ film ? film.title : '—' }}</span></div>
        <div class="row"><span class="l">Date</span><span class="v">{{ screening and screening.scheduledDate ? screening.scheduledDate|date('d/m/Y') : '—' }}</span></div>
        <div class="row"><span class="l">Heure</span><span class="v">{{ screening and screening.startTime ? screening.startTime|date('H:i') : '—' }}</span></div>
        <div class="row"><span class="l">Salle</span><span class="v">{{ screening and screening.venue ? screening.venue : '—' }}</span></div>

        {% if ticket.status.value == 'active' and not justChecked %}
            <form method="post" action="{{ path('api_cinematheque_tickets_validate', {reference: ticket.ticketNumber, token: token}) }}">
                <button type="submit" class="confirm-btn">Valider l'entrée</button>
            </form>
            <div class="note">Vérifiez l'identité du participant avant de valider.</div>
        {% elseif justChecked %}
            <div class="note">Accès autorisé à l'instant pour {{ registration ? registration.fullName : 'ce participant' }}.</div>
        {% elseif ticket.status.value == 'used' %}
            <div class="note">Déjà utilisé le {{ ticket.usedAt ? ticket.usedAt|date('d/m/Y à H:i') : '—' }}.</div>
        {% endif %}
    </div>
</div>

</body>
</html>
