{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Réglages billetterie Cinémathèque{% endblock %}

{% block main %}
    <div class="row">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.bookingUrl, null, {label_attr: {class: 'form-label fw-bold'}}) }}
                            {{ form_widget(form.bookingUrl, {attr: {class: 'form-control'}}) }}
                            {% if form.bookingUrl.vars.help %}
                                <div class="form-text">{{ form.bookingUrl.vars.help }}</div>
                            {% endif %}
                            {{ form_errors(form.bookingUrl) }}
                        </div>
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
