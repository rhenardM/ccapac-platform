<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Administration — Grand Tambour</title>
    <style>
        :root { --primary: #1f4f7a; --bg: #f4efe6; --border: #e0d3bd; }
        * { box-sizing: border-box; }
        body {
            margin: 0; min-height: 100vh; display: grid; place-items: center;
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
            background: var(--bg); color: #2a2a2a;
        }
        .card {
            width: 100%; max-width: 380px; background: #fff; padding: 2rem;
            border: 1px solid var(--border); border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0,0,0,.06);
        }
        h1 { font-size: 1.15rem; margin: 0 0 .25rem; color: var(--primary); }
        p.sub { margin: 0 0 1.5rem; font-size: .85rem; color: #7a7a7a; }
        label { display: block; font-size: .75rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: .04em; color: #666; margin-bottom: .35rem; }
        input {
            width: 100%; padding: .7rem .85rem; margin-bottom: 1rem; font-size: .95rem;
            border: 1px solid var(--border); border-radius: 8px; background: #fdfbf7;
        }
        input:focus { outline: none; border-color: var(--primary); }
        button {
            width: 100%; padding: .8rem; font-size: .85rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: .05em; color: #fff;
            background: var(--primary); border: 0; border-radius: 8px; cursor: pointer;
        }
        button:hover { background: #17405f; }
        .error {
            background: #fdecec; border: 1px solid #f5c2c2; color: #b02a2a;
            padding: .7rem .85rem; border-radius: 8px; font-size: .85rem; margin-bottom: 1rem;
        }
        .brand { text-align: center; margin-bottom: 1.5rem; font-weight: 800;
            color: var(--primary); letter-spacing: .02em; }
    </style>
</head>
<body>
    <form class="card" method="post">
        <div class="brand"></div>
        <h1>Administration</h1>
        <p class="sub">Connectez-vous pour accéder au tableau de bord.</p>

        {% if error %}
            <div class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <label for="username">Adresse e-mail</label>
        <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus autocomplete="email">

        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="_password" required autocomplete="current-password">

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit">Se connecter</button>
    </form>
</body>
</html>
