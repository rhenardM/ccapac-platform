# =============================================================================
# CCAPAC Platform — variables d'environnement (un fichier .env par environnement)
#
# En staging / production, ce fichier est écrit sur le serveur par la CI/CD à
# partir du secret GitHub `DOTENV` de l'environnement (Settings → Environments).
# Ne jamais le committer. Générer les secrets avec : openssl rand -hex 32
# Le fichier est lu par bash (deploy.sh) ET par docker compose : mettre entre
# guillemets simples toute valeur contenant espaces, *, (, ), $ ou \.
# =============================================================================

COMPOSE_PROJECT_NAME=ccapac-dev
TZ=Africa/Kinshasa

# --- Mode d'exposition ---
# VPS partagé avec Caddy (cas de srv1976360) : Caddy garde 80/443 et le TLS,
# Nginx n'écoute que sur 127.0.0.1:EDGE_PORT (8080 production, 8081 staging).
#   COMPOSE_FILE='docker-compose.yml:docker-compose.prod.yml:docker-compose.caddy.yml'
#   EDGE_PORT=8081
# VPS dédié : laisser vides (Nginx publie 80/443 + certbot).
# COMPOSE_FILE=
# EDGE_PORT=
# Ajouter www.<SITE_DOMAIN> dans Caddy (uniquement si le DNS www existe).
CADDY_INCLUDE_WWW=false

# --- Images (renseignées par la CI en staging/prod) ---
REGISTRY=ccapac
IMAGE_TAG=local

# --- Domaines (un sous-domaine par service public) ---
# Production : centreculturel.cd / api.centreculturel.cd / app-api.centreculturel.cd
# Staging    : staging.centreculturel.cd / api-staging.centreculturel.cd / app-api-staging.centreculturel.cd
SITE_DOMAIN=localhost
API_DOMAIN=api.localhost
NODE_API_DOMAIN=app-api.localhost
LETSENCRYPT_EMAIL=

# --- PostgreSQL (une base + un rôle par application) ---
POSTGRES_PASSWORD=change-me-postgres-superuser
POSTGRES_API_PASSWORD=change-me-api
POSTGRES_MEMBERS_PASSWORD=change-me-members

# --- MySQL transitoire du node-api ---
NODE_DB_PASSWORD=change-me-node
NODE_DB_ROOT_PASSWORD=change-me-node-root

# --- Redis (cache, sessions, rate-limiters, file Messenger) ---
# Caractères URL-safe uniquement (openssl rand -hex 32).
REDIS_PASSWORD=change-me-redis

# --- Secrets partagés ---
# JWT_SECRET : partagé node-api (signature) ↔ frontend (vérification).
JWT_SECRET=change-me-jwt
# EMAIL_RELAY_SECRET : node-api → frontend /api/internal/send-email.
EMAIL_RELAY_SECRET=change-me-relay
# INTERNAL_API_KEY : frontend ↔ backend Symfony.
INTERNAL_API_KEY=change-me-internal

# --- Backend Symfony ---
BACKEND_APP_SECRET=change-me-symfony
# Regex des origines autorisées (navigateur) sur /api/*.
BACKEND_CORS_ALLOW_ORIGIN='^https://(www\.)?localhost$'
BACKEND_MAILER_DSN=null://null
MAILER_FROM_ADDRESS=noreply@centreculturel.cd
MAILER_FROM_NAME="Biblio-Librairie du Grand Tambour"
CAMPAIGN_GOAL_USD=0

# Makuta Cash (la clé privée RSA va dans infra/secrets/makuta_private.pem).
MAKUTA_ENV=dev
MAKUTA_CLIENT_ID=
MAKUTA_CLIENT_SECRET=
MAKUTA_X_EXTENSION=

# --- Frontend Next.js ---
PAYMENT_ENABLED=false
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=
FUNDRAISING_ADMIN_EMAILS=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
AKSESSIFY_API_BASE_URL=
AKSESSIFY_API_KEY=
AKSESSIFY_CAMPAIGN_ID=

# --- Cloudinary (frontend + node-api) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Node API ---
JWT_EXPIRE=7d
INTERNAL_AUTH_PATH=

# --- Sauvegardes ---
# Clé PUBLIQUE age (age-keygen -y). La clé privée reste HORS du serveur.
BACKUP_AGE_RECIPIENT=
# Destination rclone hors serveur, ex. b2:ccapac-backups/production
BACKUP_RCLONE_DEST=
BACKUP_CRON='30 2 * * *'
BACKUP_RETENTION_DAYS=14
