# Mode « TLS direct » : Nginx est exposé sur 80/443 et termine le TLS
# (certificats Let's Encrypt via le conteneur certbot).
# Généré au démarrage depuis SITE_DOMAIN, API_DOMAIN, NODE_API_DOMAIN.

include /etc/nginx/snippets/upstreams.conf;

# --- HTTP : challenge ACME puis redirection systématique vers HTTPS ---
server {
	listen 80 default_server;
	server_name _;

	location = /nginx-health { access_log off; return 200 "ok\n"; }
	location /.well-known/acme-challenge/ { root /var/www/certbot; }
	location / { return 301 https://$host$request_uri; }
}

# --- Hôte inconnu en HTTPS : connexion fermée (pas de fuite d'application) ---
server {
	listen 443 ssl default_server;
	http2 on;
	server_name _;
	include /etc/nginx/snippets/tls.conf;
	return 444;
}

server {
	listen 443 ssl;
	http2 on;
	server_name www.${SITE_DOMAIN};
	include /etc/nginx/snippets/tls.conf;
	return 301 https://${SITE_DOMAIN}$request_uri;
}

server {
	listen 443 ssl;
	http2 on;
	server_name ${SITE_DOMAIN};
	include /etc/nginx/snippets/tls.conf;
	include /etc/nginx/snippets/site-frontend.conf;
}

server {
	listen 443 ssl;
	http2 on;
	server_name ${API_DOMAIN} ${API_DOMAIN_ALIASES};
	include /etc/nginx/snippets/tls.conf;
	include /etc/nginx/snippets/site-backend.conf;
}

server {
	listen 443 ssl;
	http2 on;
	server_name ${NODE_API_DOMAIN};
	include /etc/nginx/snippets/tls.conf;
	include /etc/nginx/snippets/site-node-api.conf;
}
