# Généré au démarrage depuis les variables SITE_DOMAIN, API_DOMAIN, NODE_API_DOMAIN.

upstream frontend_app { zone frontend_app 64k; server frontend:3000 resolve; keepalive 16; }
upstream backend_app  { zone backend_app 64k;  server backend:8080 resolve;  keepalive 16; }
upstream node_api_app { zone node_api_app 64k; server node-api:5000 resolve; keepalive 16; }

# --- HTTP : challenge ACME puis redirection systématique vers HTTPS ---
server {
	listen 80 default_server;
	server_name _;

	location = /nginx-health { access_log off; return 200 "ok\n"; }
	location /.well-known/acme-challenge/ { root /var/www/certbot; }
	location / { return 301 https://$host$request_uri; }
}

# --- Hôte inconnu en HTTPS : connexion fermée (pas de fuite d'application) ---
server {
	listen 443 ssl default_server;
	http2 on;
	server_name _;
	include /etc/nginx/snippets/tls.conf;
	return 444;
}

# --- www -> domaine principal ---
server {
	listen 443 ssl;
	http2 on;
	server_name www.${SITE_DOMAIN};
	include /etc/nginx/snippets/tls.conf;
	return 301 https://${SITE_DOMAIN}$request_uri;
}

# --- Site public + espace membre (Next.js) ---
server {
	listen 443 ssl;
	http2 on;
	server_name ${SITE_DOMAIN};
	include /etc/nginx/snippets/tls.conf;
	include /etc/nginx/snippets/security-headers.conf;
	include /etc/nginx/snippets/deny-sensitive.conf;

	limit_conn perip 50;

	location ~ ^/api/(fundraising|makuta)/ {
		limit_req zone=payment burst=10 nodelay;
		include /etc/nginx/snippets/proxy.conf;
		proxy_pass http://frontend_app;
	}

	location /_next/static/ {
		include /etc/nginx/snippets/proxy.conf;
		proxy_pass http://frontend_app;
		expires 1y;
		add_header Cache-Control "public, immutable";
	}

	location / {
		limit_req zone=general burst=60 nodelay;
		include /etc/nginx/snippets/proxy.conf;
		proxy_pass http://frontend_app;
	}
}

# --- API Symfony : contenu, dons Makuta, cinémathèque, back-office ---
server {
	listen 443 ssl;
	http2 on;
	server_name ${API_DOMAIN};
	include /etc/nginx/snippets/tls.conf;
	include /etc/nginx/snippets/security-headers.conf;
	include /etc/nginx/snippets/deny-sensitive.conf;

	limit_conn perip 40;

	# Connexions (back-office HTML et API admin) : anti brute-force.
	location ~ ^/(login|api/admin/login)$ {
		limit_req zone=auth burst=5 nodelay;
		include /etc/nginx/snippets/proxy.conf;
		proxy_pass http://backend_app;
	}

	# Création de dons / OTP / callbacks Makuta.
	location /api/fundraising/ {
		limit_req zone=payment burst=10 nodelay;
		include /etc/nginx/snippets/proxy.conf;
		proxy_pass http://backend_app;
	}

	location /uploads/ {
		limit_req zone=general burst=60 nodelay;
		include /etc/nginx/snippets/proxy.conf;
		proxy_pass http://backend_app;
		expires 7d;
	}

	location / {
		limit_req zone=api burst=30 nodelay;
		include /etc/nginx/snippets/proxy.conf;
		proxy_pass http://backend_app;
	}
}

# --- API Node : authentification membres/équipe, workflow des demandes ---
server {
	listen 443 ssl;
	http2 on;
	server_name ${NODE_API_DOMAIN};
	include /etc/nginx/snippets/tls.conf;
	include /etc/nginx/snippets/security-headers.conf;
	include /etc/nginx/snippets/deny-sensitive.conf;

	limit_conn perip 40;

	location ~ ^/api/auth/(login|register|google|forgot-password|reset-password|resend-verification|change-password)$ {
		limit_req zone=auth burst=5 nodelay;
		include /etc/nginx/snippets/proxy.conf;
		proxy_pass http://node_api_app;
	}

	location / {
		limit_req zone=api burst=30 nodelay;
		include /etc/nginx/snippets/proxy.conf;
		proxy_pass http://node_api_app;
	}
}
